---
import { getLangFromUrl, useTranslations, localizePath } from "../i18n";
import { SOCIAL } from "../consts";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const specHref = SOCIAL.github;
---

<section class="hero" id="top">
  <div class="shell hero__inner">
    <p class="kicker">{t("hero.kicker")}</p>
    <h1 class="hero__title">{t("hero.title")}</h1>
    <p class="hero__sub">{t("hero.sub")}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={`${specHref}#readme`}>{t("hero.cta2")}</a>
      <a class="btn btn--ghost" href={localizePath("/#chain", lang)}>{t("hero.cta")}</a>
    </div>
    <div class="hero__meta">
      <span><b>13</b> {t("hero.meta.chain")}</span>
      <span><b>GATE</b> {t("hero.meta.gate")}</span>
      <span><b>final_id</b> {t("hero.meta.exit")}</span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 96px 0 72px;
  }
  .hero__inner {
    max-width: 860px;
  }
  .hero__title {
    margin-top: 18px;
    font-size: clamp(34px, 5.4vw, 58px);
    letter-spacing: -0.02em;
  }
  .hero__sub {
    margin-top: 22px;
    font-size: 17px;
    line-height: 1.75;
    color: var(--ink-dim);
    max-width: 640px;
  }
  .hero__actions {
    margin-top: 34px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .hero__meta {
    margin-top: 44px;
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }
  .hero__meta b {
    color: var(--amber);
    font-weight: 800;
  }
  .hero__meta span {
    display: inline-flex;
    gap: 8px;
    align-items: baseline;
  }
</style>
