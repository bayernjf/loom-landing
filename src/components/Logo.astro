---
// Loom mark — a warp loom with three threads entering and one audited thread exiting.
const size = Astro.props.size ?? 32;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Loom"
>
  <rect x="3" y="3" width="26" height="26" rx="6" fill="var(--steel-900)" stroke="var(--steel-500)" />
  <!-- warp threads in -->
  <path d="M8 11V22" stroke="var(--teal)" stroke-width="1.6" stroke-linecap="round" />
  <path d="M13 10.5V22" stroke="var(--teal)" stroke-width="1.6" stroke-linecap="round" opacity="0.6" />
  <path d="M18 11V22" stroke="var(--teal)" stroke-width="1.6" stroke-linecap="round" opacity="0.35" />
  <!-- heddle / gate bar -->
  <rect x="6.5" y="15" width="19" height="3" rx="1.5" fill="var(--amber)" />
  <!-- audited thread out -->
  <path d="M24 12C26 14 26 18 24 20" stroke="var(--amber)" stroke-width="1.8" stroke-linecap="round" />
</svg>
