---
import { getLangFromUrl, useTranslations } from "../i18n";
import { SOCIAL } from "../consts";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="cta" id="cta">
  <div class="shell">
    <div class="panel cta__panel">
      <div>
        <h2 class="cta__title">{t("cta.title")}</h2>
        <p class="cta__sub">{t("cta.sub")}</p>
      </div>
      <div class="cta__actions">
        <a class="btn btn--primary" href={`mailto:${SOCIAL.email}`}>{t("cta.button")}</a>
        <span class="cta__email">{SOCIAL.email}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: 56px 0 80px;
  }
  .cta__panel {
    padding: 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
    background:
      radial-gradient(circle at 85% 20%, rgba(255, 179, 64, 0.08), transparent 45%),
      var(--steel-900);
  }
  .cta__title {
    font-size: clamp(24px, 3vw, 34px);
  }
  .cta__sub {
    margin-top: 10px;
    color: var(--ink-dim);
    max-width: 520px;
  }
  .cta__actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .cta__email {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-faint);
  }
</style>
