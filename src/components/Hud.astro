---
import Logo from "./Logo.astro";
---

<header class="top">
  <div class="shell top__inner">
    <a class="top__brand" href="/" aria-label="Loom">
      <Logo size={30} />
      <span class="top__name">LOOM</span>
    </a>
    <span class="top__status">
      <span class="dot"></span>
      v0.1 · DESIGN PHASE
    </span>
  </div>
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    padding: 14px 0;
    background: color-mix(in srgb, var(--steel-950) 82%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: var(--hair);
  }
  .top__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .top__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    --logo-size: 30px;
  }
  .top__name {
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.3em;
  }
  .top__status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--ink-faint);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--warn);
    box-shadow: 0 0 8px var(--warn);
  }
</style>
